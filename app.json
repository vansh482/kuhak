{
  "expo": {
    "name": "Kuhak",
    "slug": "kuhak",
    "scheme": "kuhak",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080C",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.kuhak.game",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08080C"
      },
      "permissions": ["android.permission.VIBRATE"]
    },
    "ios": {
      "bundleIdentifier": "com.kuhak.game",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      "expo-status-bar"
    ]
  }
}
